APP_NAME="Academic Monitoring System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4+ or MariaDB (InnoDB, utf8mb4).
# Defaults match XAMPP's MySQL (MariaDB): use DB_CONNECTION=mysql for MySQL servers.
# Production must use a dedicated account limited to this database, never root.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=academic_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the application is served over HTTPS (recommended for internal deployments).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No background worker is required for the MVP.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@academic-system.local"
MAIL_FROM_NAME="${APP_NAME}"

# Inertia: no SSR server and no DevTools recording for this application.
INERTIA_SSR_ENABLED=false
INERTIA_DEVTOOLS_ENABLED=false
# Encrypts page data kept in browser history. Requires HTTPS (or localhost).
INERTIA_ENCRYPT_HISTORY=false

# Institution and branding. Assets live in public/branding/.
# Leave the logo and favicon empty to use the neutral placeholder mark.
ORGANIZATION_NAME="Philippine Army Officer Candidate School"
ORGANIZATION_LOGO_URL=/branding/logo.jpg
# Sign-in background served locally. Leave empty for a plain green background.
LOGIN_IMAGE_URL=/branding/login-campus.jpg
# Background below 1280 x 860 (the card cannot line up with login-campus.jpg there).
LOGIN_COMPACT_IMAGE_URL=/branding/login-background.png
# Small "Powered by" credit under the sign-in form; empty name hides it.
POWERED_BY_NAME="ServLife Solutions"
POWERED_BY_LOGO_URL=/branding/powered-by-logo.png
ORGANIZATION_FAVICON_URL=/branding/favicon.png
APP_SHORT_NAME="Academic System"
# Timezone used when displaying dates (data is stored in UTC).
INSTITUTION_TIMEZONE=UTC
# ISO 4217 currency code shown on Statements of Account (for example PHP).
INSTITUTION_CURRENCY=PHP

# Password for synthetic demo accounts (local development only).
# Leave empty to use the default documented in README.md.
DEMO_ACCOUNT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Sign-in page texts (optional)
LOGIN_HEADER_TITLE="Officer Candidate School"
LOGIN_HEADER_SUBTITLE="Philippine Army"
INSTITUTION_CORE_VALUES="Discipline,Integrity,Valor,Duty"
# The motto is part of login-campus.jpg; set it here only with a background without it.
LOGIN_MOTTO=
LOGIN_TAGLINE="Secure platform for candidate records, training monitoring, evaluations, and administrative support."
HELP_DESK_CONTACT=
